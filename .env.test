# Safe-to-commit test defaults for `pnpm test:e2e` (Next.js auto-loads this
# file when NODE_ENV=test; .env.local is intentionally NOT loaded in that
# mode, so every developer/CI run gets identical values). None of these
# protect real data — DATABASE_URL points at a local-only test database.
#
# To exercise the real Stripe-checkout-redirect assertion, add a
# `.env.test.local` (gitignored) overriding STRIPE_SECRET_KEY /
# STRIPE_PRICE_PRO_MONTHLY / STRIPE_PRICE_PRO_ANNUAL with real test-mode
# values — the billing e2e test detects and adapts to whichever is present.

# Assumes a local Postgres superuser role matching your OS username (the
# Homebrew postgresql@17 default) with a `threadextract_test` database
# already created (`createdb threadextract_test`). Override via
# .env.test.local if your local setup differs (different role/CI runner).
DATABASE_URL="postgresql://ashishbhagat@localhost:5432/threadextract_test?schema=public"

SLACK_CLIENT_ID="e2e-slack-client-id"
SLACK_CLIENT_SECRET="e2e-slack-client-secret"
SLACK_SIGNING_SECRET="e2e-slack-signing-secret"

GEMINI_API_KEYS=""
GROQ_API_KEYS=""

NEXT_PUBLIC_BASE_URL="http://localhost:3100"

TOKEN_ENCRYPTION_KEY="MDEyMzQ1Njc4OTAxMjM0NTY3ODkwMTIzNDU2Nzg5MDE="
CLAIM_TOKEN_SECRET="e2e0000000000000000000000000000000000000000000000000000000001"

NEXTAUTH_SECRET="e2e0000000000000000000000000000000000000000000000000000000002"
NEXTAUTH_URL="http://localhost:3100"
AUTH_TRUST_HOST="true"
GOOGLE_CLIENT_ID="e2e-google-client-id"
GOOGLE_CLIENT_SECRET="e2e-google-client-secret"
RESEND_API_KEY="e2e-resend-key"
EMAIL_FROM="ThreadExtract <hello@korrali.com>"

STRIPE_SECRET_KEY="sk_test_placeholder_not_a_real_key"
STRIPE_WEBHOOK_SECRET="whsec_e2e0000000000000000000000000000"
STRIPE_PRICE_PRO_MONTHLY=""
STRIPE_PRICE_PRO_ANNUAL=""

# Real Notion credentials for the opt-in AI->Notion round-trip test
# (e2e/ai-notion-roundtrip.spec.ts) — blank by default, so that test skips.
# Set via .env.test.local, not here. The integration must be shared with
# the target database (Notion requires per-database sharing, see README).
E2E_NOTION_TOKEN=""
E2E_NOTION_DATABASE_ID=""
