# Database
DATABASE_URL="postgresql://user:password@localhost:5432/threadextract?schema=public"

# Slack app (https://api.slack.com/apps)
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_SIGNING_SECRET=

# AI providers — comma-separated keys, tried in order with automatic fallback/rotation
GEMINI_API_KEYS=
GROQ_API_KEYS=

# Base URL used to build OAuth redirect URIs (e.g. https://threadextract.korrali.com)
NEXT_PUBLIC_BASE_URL="http://localhost:3000"

# Token encryption for Slack/Notion tokens at rest — 32 bytes, base64
# Generate with: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=

# Workspace-claim + OAuth CSRF-state signing secret
# Generate with: openssl rand -hex 32
CLAIM_TOKEN_SECRET=

# Auth (NextAuth v5) — Google OAuth + Resend magic-link
# Generate NEXTAUTH_SECRET with: openssl rand -hex 32
NEXTAUTH_SECRET=
NEXTAUTH_URL="http://localhost:3000"
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
RESEND_API_KEY=
EMAIL_FROM="ThreadExtract <hello@korrali.com>"
# Required in any deployment behind a reverse proxy (EC2/nginx) — without it
# Auth.js rejects every request with "UntrustedHost" since the Host header
# it sees doesn't match NEXTAUTH_URL's origin. Not needed for local dev.
AUTH_TRUST_HOST="true"

# Stripe billing
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_ANNUAL=
